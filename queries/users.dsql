-- ============================================================
-- Ordinary comments before everything.
-- These must be ignored.
-- ============================================================


--> GetById one
select *
from users
where id = $id;


-- Ordinary comment between queries.
-- Another ordinary comment.


--> GetList many
select *
from users
where name ilike $data.name
   -- Comment in the middle of the query.
   or surname ilike $data.surname
order by $orderBy $data.order
limit $limit;


-- ============================================================
-- Multiple ordinary comments before metadata.
-- ============================================================

--> Count count
select count(*)
from users
where (
    name ilike $data.name
    -- Comment between expression tokens.
    or surname ilike $data.surname
);


-- ============================================================
-- Query without metadata.
-- Expected: warning.
-- ============================================================

select *
from users
where active = true;


-- More SQL belonging to the abandoned query.
select *
from users
where deleted_at is null;


-- ============================================================
-- Metadata without query.
-- Expected: warning.
-- ============================================================

--> Orphaned one


-- ============================================================
-- Metadata followed only by ordinary comments.
-- Expected: warning.
-- ============================================================

--> EmptyQuery exec

-- Nothing here.


-- ============================================================
-- Two metadata lines without a query.
-- Expected: warning for the first metadata.
-- Expected: warning for the second at EOF.
-- ============================================================

--> FirstWithoutQuery one

--> SecondWithoutQuery many


-- ============================================================
-- Normal query after orphaned metadata.
-- ============================================================

--> GetUsers many
-- Comment immediately after metadata.
select *
from users
where id = $id;


-- ============================================================
-- Inline comment after semicolon.
-- ============================================================

--> DeleteUser exec
delete from users
where id = $id; -- Delete the user.


-- ============================================================
-- Comments inside the query.
-- ============================================================

--> UpdateUser exec
update users
set
    name = $data.name, -- User's name
    surname = $data.surname
where id = $id;


-- ============================================================
-- Multiple ordinary comments inside the query.
-- ============================================================

--> ComplexQuery many
select *
from users
-- Filter active users.
where active = true
-- Sort newest first.
order by created_at desc
-- Limit result.
limit $limit;


-- ============================================================
-- Metadata immediately followed by another metadata.
-- Expected: warning.
-- ============================================================

--> UnusedOne one
--> UnusedTwo many
select *
from users;


-- ============================================================
-- Query with no trailing semicolon.
-- If your format requires semicolon, this should NOT be accepted
-- as a complete query.
-- ============================================================

--> NoSemicolon one
select *
from users
where id = $id


-- ============================================================
-- PostgreSQL string containing "--".
-- This exposes the weakness of beforeFirst(line, "--").
-- ============================================================

--> StringWithComment one
select *
from users
where name = 'hello -- this is not a comment';


-- ============================================================
-- PostgreSQL string containing semicolon.
-- This exposes the weakness of HasSuffix(..., ";").
-- ============================================================

--> StringWithSemicolon one
select *
from users
where name = 'hello;';


-- ============================================================
-- Both "--" and ";" inside a string.
-- ============================================================

--> StringEdgeCase one
select *
from users
where name = 'hello -- world;';


-- ============================================================
-- Dollar-quoted PostgreSQL string.
-- Important for the future DSQL lexer.
-- ============================================================

--> DollarQuoted one
select $tag$
hello;
-- this is not a SQL comment
$data.name is not a DSQL parameter
$tag$;


-- ============================================================
-- DSQL-looking text inside an ordinary SQL comment.
-- Must NOT become metadata.
-- ============================================================

-- --> FakeMetadata many
select *
from users;


-- ============================================================
-- DSQL-looking text inside SQL.
-- Must remain ordinary SQL/comment content.
-- ============================================================

--> CommentWithArrow one
select
    1 --> this is an ordinary SQL comment
;


-- ============================================================
-- Another valid query after all edge cases.
-- ============================================================

--> FinalQuery many
select *
from users
where id = $id;